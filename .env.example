# Copy to .env.local for local development, and add the same keys as Worker
# secrets/vars in Cloudflare for preview and production.
#
# One exception: NEXT_PUBLIC_* is inlined by `next build`, which runs on your
# machine during `npm run deploy`. A Worker variable in the dashboard is read at
# runtime and so arrives too late. Those values live in .env.production, which
# is committed.

# --- Media -----------------------------------------------------------------
# Where /media/... is served from. Leave this line commented out in .env.local:
# .env.local wins over .env.production even in a production build, so an empty
# value there blanks the media origin at deploy time and every asset 404s.
# Unset means public/media answers, which is what you want while re-ingesting.
# Production sets it in .env.production to the R2 bucket behind
# media.alcreatives.com, which — unlike Worker static assets — answers Range
# requests, so video streams instead of downloading whole.
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Contact form (Resend) -------------------------------------------------
# Every submission sends two emails: the inquiry to CONTACT_TO_EMAIL, and a
# receipt to whoever filled in the form. Both go out from CONTACT_FROM_EMAIL.
# Without these three the site still builds and runs; the form simply tells
# people to email directly, and every submission is logged server-side.
RESEND_API_KEY=
CONTACT_TO_EMAIL=          # where inquiries land (Alvin's inbox)
# A verified sender on a domain you own in Resend. A display name is allowed
# and is what the sender sees: Alvin Creatives <hello@alcreatives.com>
CONTACT_FROM_EMAIL=
